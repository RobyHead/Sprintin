    characterSetSelectionMode: 8
    characterSequence: "\u8FD9\u662F\u4E2A\u6CA1\u6709\u58F0\u97F3\u7684\u793A\u8303\r\n\u5728\u97F3\u7B26\u4E0E\u8F68\u9053\u91CD\u5408\u65F6\u6309\u4E0B\r\n\u4ECE\u5DE6\u5230\u53F3\u5206\u522B\u662F\r\n\u51C6\u5907\u597D\r\n\u63A5\u4E0B\u6765\u662F\u957F\u6309\r\n\u5B8C\u5168\u7ED3\u675F\u624D\u80FD\u677E\u624B\u54E6\r\n\u63A5\u4E0B\u6765\u662F\u8DF3\u8DC3\r\n\u5728\u969C\u788D\u5230\u6765\u524D\u6309\u4E0B\u7A7A\u683C\r\n\u597D\u8036\uFF0C\u5269\u4E0B\u7684\u5185\u5BB9\u656C\u8BF7\u671F\u5F85\u5427\r\n\u81EA\u7528\u5F00\u53D1\u66F2\u5305\r\n\u5728\u7B2C\u4E09\u62CD\u6309\u4E0B\u7A7A\u683C\r\n\u4FDD\u5B58\u5B8C\u6210\u5E76\u8FD4\u56DE\r\n\u5EF6\u8FDF\u6821\u51C6\r\n\u9000\u51FA\u8BBE\u7F6E\u5F00\u59CB\u6E38\u620F\r\n\u5207\u6362\u9009\u9879\u8C03\u8282\u6570\u503C\r\n\u6309\u4EFB\u610F\u952E\u7EE7\u7EED\r\n\u9009\u62E9\u96BE\u5EA6\u66F2\u5305\u4E50\u66F2\r\n\u91CD\u65B0\u5F00\u59CB\r\n\u4F60\u597D\uFF01\u6B22\u8FCE\u6765\u5230\u4F60\u5C06\u901A\u8FC7\u672C\u6559\u7A0B\u4E86\u89E3\u6E38\u620F\u7684\u57FA\u672C\u73A9\u6CD5\u901A\u8FC7\u63A7\u5236\u56DB\u6761\u8F68\u9053\u9996\u5148\u662F\u97F3\u7B26\u957F\u5F97\u50CF\u8FD9\u4E2A\r\n\u5F88\u597D\u63A5\u4E0B\u6765\u662F\u97F3\u7B26\u6309\u4E0B\u7A7A\u683C\u8DF3\u8DC3\u4E0D\u8981\u78B0\u5230\u5730\u9762\u7684\u969C\u788D\u4E0D\u9519\u5728\u5F00\u5934\u4E0E\u8F68\u9053\u91CD\u5408\u65F6\u6309\u4E0B\u4E00\u76F4\u5230\u7ED3\u675F\u540E\u624D\u80FD\u677E\u624B\u54E6\r\n\u597D\u8036\u4F60\u5DF2\u7ECF\u638C\u63E1\u4E86\u8FD9\u4E2A\u6E38\u620F\u63A5\u4E0B\u6765\u628A\u6240\u6709\u97F3\u7B26\u6DF7\u5408\u5728\u4E00\u8D77\u96C6\u4E2D\u6CE8\u610F\u529B\u51C6\u5907\u51FA\u53D1\r\n\u606D\u559C\u4F60\u6559\u7A0B\u5FEB\u7ED3\u675F\u4E86\u518D\u4ECB\u7ECD\u4E24\u4E2A\u5FEB\u6377\u952E\u957F\u6309\u53EF\u4EE5\u91CD\u65B0\u5F00\u59CB\u9000\u51FA\u5230\u9009\u66F2\u83DC\u5355\u4F60\u5DF2\u7ECF\u77E5\u9053\u4E86\u6240\u6709\u91CD\u8981\u7684\u64CD\u4F5C\r\n\u63A5\u4E0B\u6765\u8BF7\u81EA\u7531\u63A2\u7D22\u5427\u611F\u8C22\u4F60\u6E38\u73