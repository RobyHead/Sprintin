    characterSetSelectionMode: 8
    characterSequence: "\u8FD9\u662F\u4E2A\u6CA1\u6709\u58F0\u97F3\u7684\u793A\u8303\r\n\u5728\u97F3\u7B26\u4E0E\u8F68\u9053\u91CD\u5408\u65F6\u6309\u4E0B\r\n\u4ECE\u5DE6\u5230\u53F3\u5206\u522B\u662F\r\n\u51C6\u5907\u597D\r\n\u63A5\u4E0B\u6765\u662F\u957F\u6309\r\n\u5B8C\u5168\u7ED3\u675F\u624D\u80FD\u677E\u624B\u54E6\r\n\u63A5\u4E0B\u6765\u662F\u8DF3\u8DC3\r\n\u5728\u969C\u788D\u5230\u6765\u524D\u6309\u4E0B\u7A7A\u683C\r\n\u597D\u8036\uFF0C\u5269\u4E0B\u7684\u5185\u5BB9\u656C\u8BF7\u671F\u5F85\u5427\r\n\u81EA\u7528\u5F00\u53D1\u66F2\u5305\r\n\u5728\u7B2C\u4E09\u62CD\u6309\u4E0B\u7A7A\u683C\r\n\u4FDD\u5B58\u5B8C\u6210\u5E76\u8FD4\u56DE\r\n\u5EF6\u8FDF\u6821\u51C6\r\n\u9000\u51FA\u8BBE\u7F6E\u5F00\u59CB\u6E38\u620F\r\n\u5207\u6362\u9009\u9879\u8C03\u8282\u6570\u503C\r\n\u6309\u4EFB\u610F\u952E\u7EE7\u7EED\r\n\u9009\u62E9\u96BE\u5EA6\u66F2\u5305\u4E50\u66F2\r\n\u91CD\u65B0\u5F00\u59CB\r\n\u4F60\u597D\uFF01\u6B22\u8FCE\u6765\u5230\u4F60\u5C06\u901A\u8FC7\u672C\u6559\u7A0B\u4E86\u89E3\u6E38\u620F\u7684\u57FA\u672C\u73A9\u6CD5\u901A\u8FC7\u63A7\u5236\u56DB\u6761\u8F68\u9053\u9996\u5148\u662F\u97F3\u7B26\u957F\u5F97\u50CF\u8FD9\u4E2A\r\n\u5F88\u597D\u63A5\u4E0B\u6765\u662F\u97F3\u7B26\u6309\u4E0B\u7A7A\u683C\u8DF3\u8DC3\u4E0D\u8981\u78B0\u5230\u5730\u9762\u7684\u969C\u788D\u4E0D\u9519\u5728\u5F00\u5934\u4E0E\u8F68\u9053\u91CD\u5408\u65F6\u6309\u4E0B\u4E00\u76F4\u5230\u7ED3\u675F\u540E\u624D\u80FD\u677E\u624B\u54E6\r\n\u597D\u8036\u4F60\u5DF2\u7ECF\u638C\u63E1\u4E86\u8FD9\u4E2A\u6E38\u620F\u63A5\u4E0B\u6765\u628A\u6240\u6709\u97F3\u7B26\u6DF7\u5408\u5728\u4E00\u8D77\u96C6\u4E2D\u6CE8\u610F\u529B\u51C6\u5907\u51FA\u53D1\r\n\u606D\u559C\u4F60\u6559\u7A0B\u5FEB\u7ED3\u675F\u4E86\u518D\u4ECB\u7ECD\u4E24\u4E2A\u5FEB\u6377\u952E\u957F\u6309\u53EF\u4EE5\u91CD\u65B0\u5F00\u59CB\u9000\u51FA\u5230\u9009\u66F2\u83DC\u5355\u4F60\u5DF2\u7ECF\u77E5\u9053\u4E86\u6240\u6709\u91CD\u8981\u7684\u64CD\u4F5C\r\n\u63A5\u4E0B\u6765\u8BF7\u81EA\u7531\u63A2\u7D22\u5427\u611F\u8C22\u4F60\u6E38\u73A9\u6109\u5FEB\u7EE7\u7EED\u8FD9\u662F\u8FDB\u9636\u6559\u7A0B\u4F60\u53EF\u4EE5\u5B66\u4E60\u5230\u66F4\u590D\u6742\u7684\u914D\u7F6E\u4E3E\u4E00\u53CD\u4E09\uFF0C\u6311\u6218\u66F4\u9AD8\u96BE\u5EA6\r\n\u8BA9\u6211\u4EEC\u590D\u4E60\u4E00\u4E0B\u4F7F\u7528\u548C\u6253\u51FB\u97F3\u7B26\u3001\u8D8A\u8FC7\u969C\u788D\u5F53\u591A\u4E2A\u97F3\u7B26\u540C\u65F6\u5230\u8FBE\u65F6\u9700\u8981\u540C\u65F6\u6309\u4E0B\u6240\u6709\u5BF9\u5E94\u7684\u6309\u952E\u8BA9\u6211\u4EEC\u4ECE\u4E24\u4E2A\u97F3\u7B26\u5F00\u59CB\r\n\u63A5\u4E0B\u6765\u770B\u770B\u5355\u624B\u64CD\u4F5C\u6709\u65F6\u4E00\u53EA\u624B\u8981\u5FEB\u901F\u6309\u4E0B\u591A\u4E2A\u6309\u952E\u4F7F\u7528\u591A\u6839\u624B\u6307\u4E00\u8D77\u64CD\u4F5C\u8BD5\u7136\u540E\u662F\u8DF3\u8DC3\u4E0E\u5730\u9762\u969C\u788D\u770B\r\n\u5728\u843D\u4E0B\u65F6\u91CD\u65B0\u8D77\u8DF3\u8EB2\u907F\u63A5\u8FDE\u800C\u6765\u7684\u969C\u788D\u4E00\u6B21\u8DF3\u8DC3\u53EF\u4EE5\u8DE8\u8FC7\u671F\u95F4\u7684\u6240\u6709\u969C\u788D\u901A\u5E38\u6765\u8BF4\u4E00\u6B21\u8DF3\u8DC3\u7684\u65F6\u957F\u662F\u4E00\u62CD\r\n\u7CBE\u51C6\u8FDE\u7EED\u5730\u8DF3\u8DC3\u53EF\u4EE5\u8EB2\u907F\u5BC6\u96C6\u7684\u969C\u788D\u8BF7\u6CE8\u610F\u4E0E\u97F3\u7B26\u4E00\u8D77\u5230\u6765\u7684\u969C\u788D\u66F4\u591A\u7EC4\u5408\u656C\u8BF7\u671F\u5F85\u4F60\u5DF2\u7ECF\u51C6\u5907\u597D\u6311\u6218\u66F4\u9AD8\u96BE\u5EA6\r\n\u91CD\u590D\u7EC3\u4E60\u62FF\u5230\u66F4\u9AD8\u5206\u5427"
